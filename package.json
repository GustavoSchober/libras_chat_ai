{
  "name": "libras-ai-chat",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "test -x .venv/bin/python || (python -m venv .venv && .venv/bin/pip install -q -r ia/requirements.txt)",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && .venv/bin/python ia/servidor.py"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
