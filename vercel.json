{
  "framework": "vite",
  "buildCommand": "npm run build && mkdir -p web/dist/dados && cp dados/bundles.json web/dist/dados/",
  "outputDirectory": "web/dist",
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "functions": { "api/index.py": { "includeFiles": "{ia/*.py,dados/bundles.json}" } }
}
